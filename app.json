{
  "expo": {
    "name": "FloraLens",
    "slug": "react-native-flora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reactnativeflora",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2D5A27",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.abderrahmene.floralens",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F7F2",
          "dark": {
            "backgroundColor": "#1A1C19"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Light.ttf",
            "./assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/Plus_Jakarta_Sans/static/PlusJakartaSans-ExtraBold.ttf",
            "./assets/fonts/Be_Vietnam_Pro/BeVietnamPro-Light.ttf",
            "./assets/fonts/Be_Vietnam_Pro/BeVietnamPro-Regular.ttf",
            "./assets/fonts/Be_Vietnam_Pro/BeVietnamPro-Medium.ttf",
            "./assets/fonts/Be_Vietnam_Pro/BeVietnamPro-SemiBold.ttf",
            "./assets/fonts/Be_Vietnam_Pro/BeVietnamPro-Bold.ttf",
            "./assets/fonts/Be_Vietnam_Pro/BeVietnamPro-ExtraBold.ttf",
            "./assets/fonts/Bad_Script/BadScript-Regular.ttf"
          ]
        }
      ],
      "onnxruntime-react-native",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "FloraLens uses the camera to photograph leaves.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": "FloraLens uses the photos you choose to identify plants.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.abderrahmene.floralens"
    }
  }
}
